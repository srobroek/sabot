# Python surface. Base + atheris/hypothesis/bandit/ruff. opengrep, in the base, is the
# pattern scanner; semgrep was dropped because it gave opengrep's output again.
#
# atheris is the coverage-guided fuzzer, and it is the only tool here that builds
# from source: its wheel links libFuzzer, so the build needs clang, the matching
# clang runtime archive, and a C++ driver (its setup.py rejects a compiler without
# C++11). Debian ships libFuzzer in libclang-rt-<major>-dev, NOT in clang, so
# without that package the build fails "Failed to find libFuzzer" -- which is how
# this surface shipped with no fuzzer at all (bs-156).
#
# The installs are SPLIT and NOT masked by `|| true`. Both matter: pip resolves one
# invocation as a single transaction, so the atheris build failure aborted the four
# pure-python tools alongside it, and `|| true` then reported success. A failed
# install must fail the build, because a missing fuzzer reported as present returns
# a clean the campaign did not earn (isolation.md, "Assert the tools survived").
#
# Build: docker build -f Dockerfile.python -t sabot/python:1 --build-arg BASE=sabot/base:1 .
ARG BASE=sabot/base:1
FROM ${BASE}
USER root

# Pure-python tools first, so a toolchain problem in the atheris layer cannot take
# the static scanners down with it. Pinned, as every tier is, so a campaign is
# reproducible; hypothesis matches the HypoFuzz pin below.
RUN pip3 install --no-cache-dir --break-system-packages \
      'hypothesis==6.145.1' bandit==1.9.4 ruff==0.16.10

# atheris and its build toolchain. LIBFUZZER_LIB names the no_main archive (atheris
# supplies its own main). The arch suffix is resolved at build time so the layer
# builds on arm64 and amd64 alike.
ARG LLVM_MAJOR=19
RUN set -eux; \
    apt-get update -q; \
    apt-get install -y --no-install-recommends \
      "clang-${LLVM_MAJOR}" "libclang-rt-${LLVM_MAJOR}-dev" python3-dev; \
    rm -rf /var/lib/apt/lists/*; \
    ln -sf "/usr/bin/clang-${LLVM_MAJOR}" /usr/local/bin/clang; \
    ln -sf "/usr/bin/clang++-${LLVM_MAJOR}" /usr/local/bin/clang++; \
    arch="$(uname -m)"; \
    fuzzer_lib="/usr/lib/llvm-${LLVM_MAJOR}/lib/clang/${LLVM_MAJOR}/lib/linux/libclang_rt.fuzzer_no_main-${arch}.a"; \
    test -f "$fuzzer_lib"; \
    CLANG_BIN=/usr/local/bin/clang CC=clang CXX=clang++ LIBFUZZER_LIB="$fuzzer_lib" \
      pip3 install --no-cache-dir --break-system-packages atheris==3.1.0; \
    python3 -c 'import atheris'; \
    bandit --version; ruff --version; \
    python3 -c 'import hypothesis; print(hypothesis.__version__)'

# The generator and reducer tier. Split from the block above for the same reason that
# block is split from the scanners: a resolver failure here must not take the fuzzer with
# it.
#
# dharma is UNPINNED on purpose -- it has no wheel constraint worth pinning and no release
# since 1.3.2 -- while the rest are pinned so a campaign is reproducible.
#
# hypothesis is REPINNED here, and the pin is load-bearing. HypoFuzz 25.11.1 constrains
# only a floor (`hypothesis[cli,watchdog]>=6.140.2`), so the resolver takes the newest
# release, and against 6.165.10 every fuzz worker died inside hypofuzz itself:
#
#   AttributeError: 'ConjectureResult' object has no attribute 'slice_comments'.
#   Did you mean: 'span_comments'?
#
# `hypothesis fuzz` then printed `Found a failing input for every test!` -- a FALSE
# POSITIVE off a crashed worker, on a test with no bug in it. 6.145.1 is the newest
# release from before HypoFuzz 25.11.1 was published, and it fuzzes cleanly. 25.11.1 is
# the newest HypoFuzz, so the fix has to be on this side. Revisit when HypoFuzz ships a
# release that caps its own dependency.
#
# HypoFuzz also installs NO `hypofuzz` binary; it registers `hypothesis fuzz`.
#
# shrinkray is held at 26.7.6.1, the last release before it took a hard dependency on
# llama-cpp-python. From 26.7.7.0 the reducer wants an LLM runtime, which is a 74.9MB
# source build that needs a C++ toolchain this layer does not have, and it failed the build
# outright:
#
#   Could not find the compiler specified in the environment variable CXX:
#   aarch64-linux-gnu-g++
#
# An LLM-guided reducer also cannot work under `--network none` unless a model is baked,
# and a reducer is the one tool here whose value does not depend on a model. Advance this
# pin only if 26.7.6.1 stops reducing.
RUN pip3 install --no-cache-dir --break-system-packages \
      hypofuzz==25.11.1 'hypothesis[cli,watchdog]==6.145.1' \
      schemathesis==4.24.3 grammarinator==26.1 dharma shrinkray==26.7.6.1

# Assert each one WORKS, not that it answered. Every tool in this tier is a generator or a
# reducer, and one that emits nothing, or emits its input unchanged, turns a campaign into
# a single-input test that reports a clean (the radamsa/zzuf lesson in base-extras.sh).
#
# The HypoFuzz probe runs TWICE, on an unfalsifiable test and a failing one, because the
# broken hypothesis pin failed in BOTH directions: it printed a failure for a test with no
# bug in it (a false positive) while finding nothing. One direction alone passes on a
# crashed worker.
#
# `hypothesis fuzz` never returns on its own, so both runs are under `timeout` and the
# verdict comes from the artifacts: the passing test must leave hypothesis's example
# database with no failing entry to replay, and the failing one must leave an entry that
# `pytest` then reproduces without any fuzzing of its own.
#
# That replay runs with `phases=[Phase.reuse]` (SABOT_REPLAY_ONLY), so it reads the
# example database and generates nothing. A plain `pytest` replay proved nothing: its own
# generate phase finds n=0 for `assert n != 0` in milliseconds, so it passed with an
# empty database exactly as it passed with HypoFuzz's saved example. The decorators are
# identical in both runs, so the database key HypoFuzz wrote is the one pytest reads.
#
# The passing property is `isinstance(n, int)` and not a bound like `n < 10**9`, because
# `st.integers()` is unbounded and HypoFuzz DOES exceed any such bound: that first draft
# failed this probe by finding a real counterexample.
#
# grammarinator-generate IMPORTS the processed grammar as a python module, so the output
# directory has to be on PYTHONPATH. Without it, `-o` and the generator name both look
# right and the run dies:
#
#   ModuleNotFoundError: No module named 'TGenerator'
#
# The output template's `%d` is written once. A RUN passes `%` through literally rather
# than expanding it the way ENV and LABEL do, so doubling it puts a literal percent pair in
# the filename and the three-file loop below finds nothing.
#
# The grep is for `AttributeError`, not `Traceback`. Killing the fuzzer mid-run always
# leaves multiprocessing teardown tracebacks (`Exception ignored in: <Finalize object,
# dead>`), so a Traceback check fails on every healthy run.
RUN set -eux; \
    probe=/tmp/genprobe; mkdir -p "$probe"; cd "$probe"; \
    \
    printf 'from hypothesis import given, strategies as st\n\n@given(st.integers())\ndef test_clean(n):\n    assert isinstance(n, int)\n' > test_clean.py; \
    timeout 90 hypothesis fuzz -n 1 --no-dashboard -- test_clean.py > clean.log 2>&1 || true; \
    ! grep -q 'AttributeError' clean.log || \
      { echo "sabot python: hypofuzz worker crashed; hypothesis pin is incompatible" >&2; \
        grep -m3 'AttributeError' clean.log >&2; exit 1; }; \
    ! grep -q 'Found a failing input' clean.log || \
      { echo "sabot python: hypofuzz claimed a failure on a test with no bug" >&2; exit 1; }; \
    pytest -q test_clean.py > clean-replay.log 2>&1 || \
      { echo "sabot python: hypofuzz recorded a failure for a test with no bug" >&2; \
        tail -20 clean-replay.log >&2; exit 1; }; \
    rm -rf .hypothesis; \
    \
    printf 'import os\nfrom hypothesis import Phase, given, settings, strategies as st\n\nPHASES = [Phase.reuse] if os.environ.get("SABOT_REPLAY_ONLY") else list(Phase)\n\n@settings(phases=PHASES)\n@given(st.integers())\ndef test_seeded(n):\n    assert n != 0\n' > test_seeded.py; \
    timeout 90 hypothesis fuzz -n 1 --no-dashboard -- test_seeded.py > seeded.log 2>&1 || true; \
    ! SABOT_REPLAY_ONLY=1 pytest -q test_seeded.py > seeded-replay.log 2>&1 || \
      { echo "sabot python: hypofuzz did not save the seeded n=0 counterexample" >&2; exit 1; }; \
    grep -q 'Falsifying example: test_seeded' seeded-replay.log || \
      { echo "sabot python: the seeded failure did not replay from the example database" >&2; \
        tail -20 seeded-replay.log >&2; exit 1; }; \
    echo "hypofuzz: replayed the saved counterexample with generation off"; \
    \
    schemathesis --version; \
    \
    printf 'grammar T;\nstart : item+ ;\nitem  : A | B ;\nA : QA ;\nB : QB ;\n' > T.g4; \
    sed -i "s/QA/'a'/; s/QB/'b'/" T.g4; \
    grammarinator-process T.g4 -o . >/dev/null; \
    PYTHONPATH=. grammarinator-generate TGenerator.TGenerator -r start -n 3 \
      -o out_%d.txt -d 10 >/dev/null; \
    for f in out_0.txt out_1.txt out_2.txt; do \
      test -s "$f" || { echo "sabot python: grammarinator emitted an empty $f" >&2; exit 1; }; \
      grep -qE '^[ab]+$' "$f" || \
        { echo "sabot python: grammarinator output does not match the grammar" >&2; exit 1; }; \
    done; \
    echo "grammarinator: 3 files matching the grammar"; \
    \
    dharma -grammars /usr/local/lib/python3*/dist-packages/dharma/grammars/json.dg \
      -count 5 > dharma.out 2>/dev/null; \
    test -s dharma.out || { echo "sabot python: dharma generated nothing" >&2; exit 1; }; \
    echo "dharma: $(wc -c < dharma.out) bytes from its bundled json grammar"; \
    \
    printf 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxAAAAAAAAAAxxxxxxxxxxxxxxxxxxxx' > big.txt; \
    printf '#!/bin/sh\ngrep -q AAAAAAAAAA "$1"\n' > pred.sh; chmod +x pred.sh; \
    timeout 180 shrinkray ./pred.sh big.txt >/dev/null 2>&1 || true; \
    test "$(wc -c < big.txt)" -lt 30 || \
      { echo "sabot python: shrinkray did not reduce the 60-byte input" >&2; exit 1; }; \
    echo "shrinkray: 60 bytes down to $(wc -c < big.txt)"; \
    \
    cd /; rm -rf "${probe:?}"

USER breaker
WORKDIR /scratch
VOLUME /artifacts

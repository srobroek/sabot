# sabot base image. Every surface image extends this.
#
# Language-free floor: a non-root user that OWNS /artifacts (so a named volume is
# writable without --user gymnastics and without running root), the shell/config
# tooling, the cross-surface scanners that apply to any target (gitleaks, opengrep,
# ast-grep), and the CI/supply-chain scanners every target's .github/workflows and
# dependency manifests need (zizmor, actionlint, trivy, osv-scanner). A
# language surface adds its toolchain on top via a fragment
# under layers/ (see Dockerfile.rust); the agent may add a thin extension layer at
# recon time when a target needs a tool the base lacks (references/isolation.md,
# "Extending an image").
#
# Build: docker build -f Dockerfile.base -t sabot/base:1 .
#
# The base is pinned by digest, not a rolling `stable` tag, so two builds of one tag
# start from the same floor. Renovate's dockerfile manager bumps the tag and digest.
FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

# Cross-surface floor: shell tools + config scanners that apply to any target.
#
# `just` is here for the same reason shellcheck is: a repo's task runner IS its shell
# entry-point surface, and every recipe is an unfuzzed argv boundary. Measured: a
# 49-vector harness against a 34-recipe justfile could not run at all because no image
# carried the binary, and under --network none there is no runtime repair -- so the
# recipe-name resolution boundary read as untested rather than as tool-missing. Debian
# trixie packages it, so it costs one apt name and no pin of ours.
RUN apt-get update -q \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git ripgrep shellcheck just jq python3 python3-pip unzip \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s /usr/bin/rg /usr/local/bin/ripgrep \
 && just --version

# Binary scanners, pinned and arch-aware. dpkg --print-architecture gives the
# Debian arch (arm64|amd64); each release names its arm64 asset differently, so
# map once. Renovate tracks each version via the '# renovate:' comment on the ARG.
#
# Every download is verified against layers/base-binaries.sha256 BEFORE it is unpacked
# or run, keyed by its exact URL. An auditor's image that runs unverified binaries is the
# supply-chain hole it exists to find. A version bump without new digests fails the
# build on the missing key, rather than installing whatever the URL now serves.
# renovate: datasource=github-releases depName=gitleaks/gitleaks
ARG GITLEAKS_VERSION=8.30.1
# renovate: datasource=github-releases depName=ast-grep/ast-grep
ARG ASTGREP_VERSION=0.45.0
# renovate: datasource=github-releases depName=opengrep/opengrep
ARG OPENGREP_VERSION=1.26.0
# renovate: datasource=github-releases depName=mvdan/sh
ARG SHFMT_VERSION=3.13.1
# CI / supply-chain scanners. zizmor + actionlint are the only tools that do
# workflow dataflow; osv-scanner + trivy cover dependency and config CVEs. pinact was
# dropped: `zizmor --offline` reports an unpinned action itself (surfaces/infra.md).
# These read .github/workflows and the
# dependency manifests, which exist on any target regardless of language, so they
# live in the base rather than a language surface.
# renovate: datasource=github-releases depName=zizmorcore/zizmor
ARG ZIZMOR_VERSION=1.28.0
# renovate: datasource=github-releases depName=rhysd/actionlint
ARG ACTIONLINT_VERSION=1.7.12
# renovate: datasource=github-releases depName=aquasecurity/trivy
ARG TRIVY_VERSION=0.72.0
# renovate: datasource=github-releases depName=google/osv-scanner
ARG OSVSCANNER_VERSION=2.4.0
COPY layers/base-binaries.sha256 /tmp/base-binaries.sha256
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      arm64) gl=linux_arm64; ag=aarch64-unknown-linux-gnu; og=aarch64; sf=arm64; \
             zz=aarch64-unknown-linux-gnu; al=arm64; tv=ARM64; ov=arm64 ;; \
      amd64) gl=linux_x64;   ag=x86_64-unknown-linux-gnu;  og=x86;     sf=amd64; \
             zz=x86_64-unknown-linux-gnu; al=amd64; tv=64bit; ov=amd64 ;; \
      *) echo "sabot base: unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    dl=/tmp/sabot-dl; mkdir -p "$dl"; \
    fetch() { \
      want="$(awk -v u="$1" '$2 == u { print $1 }' /tmp/base-binaries.sha256)"; \
      [ -n "$want" ] || { echo "sabot base: no pinned sha256 for $1" >&2; exit 1; }; \
      curl -fsSL -o "$dl/$2" "$1"; \
      echo "$want  $dl/$2" | sha256sum -c --strict -; \
    }; \
    gh=https://github.com; \
    fetch "$gh/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_${gl}.tar.gz" gitleaks.tgz; \
    fetch "$gh/ast-grep/ast-grep/releases/download/${ASTGREP_VERSION}/app-${ag}.zip" ast-grep.zip; \
    fetch "$gh/opengrep/opengrep/releases/download/v${OPENGREP_VERSION}/opengrep_manylinux_${og}" opengrep; \
    fetch "$gh/mvdan/sh/releases/download/v${SHFMT_VERSION}/shfmt_v${SHFMT_VERSION}_linux_${sf}" shfmt; \
    fetch "$gh/zizmorcore/zizmor/releases/download/v${ZIZMOR_VERSION}/zizmor-${zz}.tar.gz" zizmor.tgz; \
    fetch "$gh/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_${al}.tar.gz" actionlint.tgz; \
    fetch "$gh/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-${tv}.tar.gz" trivy.tgz; \
    fetch "$gh/google/osv-scanner/releases/download/v${OSVSCANNER_VERSION}/osv-scanner_linux_${ov}" osv-scanner; \
    tar -xzf "$dl/gitleaks.tgz" -C /usr/local/bin gitleaks; \
    unzip -o "$dl/ast-grep.zip" -d /usr/local/bin; \
    tar -xzf "$dl/zizmor.tgz" -C /usr/local/bin zizmor; \
    tar -xzf "$dl/actionlint.tgz" -C /usr/local/bin actionlint; \
    tar -xzf "$dl/trivy.tgz" -C /usr/local/bin trivy; \
    install -m 0755 "$dl/opengrep" "$dl/shfmt" "$dl/osv-scanner" /usr/local/bin/; \
    rm -rf "${dl:?}" /tmp/base-binaries.sha256; \
    chmod +x /usr/local/bin/gitleaks /usr/local/bin/ast-grep /usr/local/bin/zizmor \
             /usr/local/bin/actionlint /usr/local/bin/trivy; \
    gitleaks version; ast-grep --version; opengrep --version; shfmt --version; \
    zizmor --version; actionlint --version; trivy --version; osv-scanner --version

# Mutators, the reducer, and the remaining config/secret scanners. Split into its own
# layer so a rebuild of the floor above does not re-download this set; the reason each
# tool is present, and why Grype and Scorecard are not, lives in the fragment.
COPY layers/base-extras.sh /tmp/base-extras.sh
RUN bash /tmp/base-extras.sh && rm /tmp/base-extras.sh

# Offline scan data baked so a `--network none` campaign scans against real data
# instead of an empty DB or a rule pack it cannot fetch -- the exact false-clean this
# package exists to kill (isolation.md, "Baked offline databases"). All under
# /opt/sabot-db, read at run time by the recipe's explicit flag (trivy --cache-dir,
# opengrep --config) or a run-contained symlink (osv via XDG_CACHE_HOME).
#
# semgrep-rules is the upstream of the opengrep/semgrep registry `p/` packs; the
# surface recipes point --config at a language subdir of it rather than `p/python`,
# which would fetch over the network. Pinned by commit SHA (tag-less rolling repo),
# advanced by hand; renovate's semver datasource cannot track a bare SHA.
ARG SEMGREP_RULES_SHA=40b8c63f75dc7c22c8a77482d73bfb864b146f7e
RUN git clone https://github.com/semgrep/semgrep-rules /opt/sabot-db/semgrep-rules \
 && git -C /opt/sabot-db/semgrep-rules checkout -q "$SEMGREP_RULES_SHA" \
 && rm -rf /opt/sabot-db/semgrep-rules/.git

# A non-root user that owns the artifacts mount. The named volume inherits this
# ownership on first mount, so the campaign writes findings without running root
# and without a host-uid match. It also owns /opt/sabot-db, the baked scan-data prefix.
RUN useradd --create-home --uid 1000 breaker \
 && mkdir -p /artifacts /scratch \
 && chown -R breaker:breaker /artifacts /scratch /opt/sabot-db
USER breaker

# The trivy vuln DB and the osv-scanner per-ecosystem DBs, otherwise fetched on first
# use. The trivy Java index is skipped (--download-db-only, not --download-java-db-only):
# no sabot surface scans JVM artifacts and it doubles the image. osv is seeded only for
# the sabot language ecosystems (crates.io, npm, PyPI, Go) via a throwaway lockfile per
# ecosystem. Both DBs are rolling snapshots, not semver-tagged, so the image tag bump is
# the version boundary and a rebuild re-pulls the current DB.
#
# The osv seed is NOT masked. osv-scanner exits 1 when it finds a vulnerability, which
# the seed's known-vulnerable lodash and requests pins guarantee, and anything above 1
# is a failed download or parse. The second run is the proof: offline, with no
# download, it must still report both seeded packages, or the DB never loaded and every
# offline scan would read as clean.
RUN trivy --cache-dir /opt/sabot-db/trivy image --download-db-only
RUN set -eux; \
    seed="$(mktemp -d)"; \
    printf '[[package]]\nname = "anyhow"\nversion = "1.0.0"\n' > "$seed/Cargo.lock"; \
    printf '{"lockfileVersion":3,"packages":{"node_modules/lodash":{"version":"4.17.20"}}}' > "$seed/package-lock.json"; \
    printf 'requests==2.20.0\n' > "$seed/requirements.txt"; \
    printf 'module x\ngo 1.20\nrequire github.com/x/y v1.0.0\n' > "$seed/go.mod"; \
    : > "$seed/go.sum"; \
    rc=0; XDG_CACHE_HOME=/opt/sabot-db/osv \
      osv-scanner scan source --download-offline-databases --offline-vulnerabilities -r "$seed" \
      > /dev/null || rc=$?; \
    [ "$rc" -le 1 ] || { echo "sabot base: osv DB download failed rc=$rc" >&2; exit 1; }; \
    rc=0; XDG_CACHE_HOME=/opt/sabot-db/osv \
      osv-scanner scan source --offline-vulnerabilities --format json -r "$seed" \
      > /tmp/osv-probe.json || rc=$?; \
    if [ "$rc" -ne 1 ] || ! grep -q '"lodash"' /tmp/osv-probe.json \
       || ! grep -q '"requests"' /tmp/osv-probe.json; then \
      echo "sabot base: the offline osv DB does not load (rc=$rc)" >&2; exit 1; fi; \
    rm -rf "${seed:?}" /tmp/osv-probe.json

WORKDIR /scratch
VOLUME /artifacts

# Node/web surface. Base + node, jazzer, fast-check, retire, eslint, playwright.
#
# Composes per the base model: FROM the language-free base, so the cross-surface
# scanners (gitleaks, opengrep, trivy, osv-scanner) and their baked databases are in
# this image too. Node itself is copied out of the official image rather than built on
# it: an image FROM node:22 would drop the whole shared floor.
#
# Build: docker build -f Dockerfile.node -t sabot/node:1 --build-arg BASE=sabot/base:1 .
#
# retire.js reads its vulnerability definitions from a `jsrepository-v5.json` it
# fetches from raw.githubusercontent.com on every run. Under --network none that
# fetch fails and retire finds nothing -- a false-clean. So the definition file is
# baked at build time and the web.md recipe runs `retire --jsrepo <baked path>`,
# which reads the local copy and skips the fetch (retire 5.x has no --noupdate flag;
# --jsrepo <local file> is the offline mechanism).
#
# The node stage is trixie-slim, the base's own Debian release, because Jazzer.js ships
# a PREBUILT arm64 native addon linked against GLIBC_2.38. Bookworm carries 2.36, so
# `jazzer` died at dlopen with ERR_DLOPEN_FAILED while `npm i -g` had reported success --
# the fuzzer was installed and unrunnable. Trixie carries 2.41 (bs-156), and the addon
# loads against the base's glibc, not the stage's.
ARG BASE=sabot/base:1
FROM node:22-trixie-slim AS node

FROM ${BASE}
USER root
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/include/node /usr/local/include/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && node --version && npm --version
# Not masked by `|| true`: a failed install must fail the build, because a missing
# fuzzer reported as present returns a clean the campaign did not earn. The build
# then RUNS each tool, since installing a native addon and loading it are different
# questions -- the one this image got wrong. git, ripgrep and ca-certificates come
# from the base.
RUN npm i -g fast-check retire >/dev/null \
 && retire --version \
 && NODE_PATH=/usr/local/lib/node_modules node -e 'require("fast-check")'

# Jazzer.js is installed LOCALLY into a prefix dir, not with `npm i -g`, and that is the
# whole fix for a fuzzer that reported itself present and could not fuzz.
#
# `npm i -g @jazzer.js/core` nests the @jazzer.js peers (bug-detectors, fuzzer, hooking,
# instrumentor) under core/node_modules/, while core resolves them as SIBLINGS. Measured,
# `jazzer --version` answered and every real run died before the first input:
#
#   Error: ENOENT: no such file or directory, scandir
#   '/usr/local/lib/node_modules/@jazzer.js/bug-detectors/dist/internal'
#
# That is the exact false-clean class this image already got wrong once with the arm64
# dlopen (bs-156): installed, asserted, unrunnable. A local install produces the flat
# sibling layout core expects.
#
# So the build ALSO runs a real fuzz target and requires a crash, not a version string.
# The target dereferences parts[1] with no colon in the input, so libFuzzer must report an
# uncaught TypeError and write a crash artifact; anything less means the addon loaded but
# the instrumentation did not.
RUN mkdir -p /opt/jazzer && cd /opt/jazzer \
 && npm init -y >/dev/null \
 && npm i @jazzer.js/core >/dev/null \
 && ln -sf /opt/jazzer/node_modules/.bin/jazzer /usr/local/bin/jazzer \
 && test -d /opt/jazzer/node_modules/@jazzer.js/bug-detectors/dist/internal \
 && jazzer --version \
 && mkdir -p /tmp/jzprobe && cd /tmp/jzprobe \
 && printf 'module.exports.fuzz = function (d) { return d.toString().split(":")[1].trim(); };\n' > fuzz.js \
 && (jazzer fuzz.js -- -runs=50000 -max_total_time=120 > out.txt 2>&1 || true) \
 && grep -q 'Uncaught Exception' out.txt \
 && echo "jazzer.js fuzzes and reports a crash (not just --version)" \
 && cd / && rm -rf /tmp/jzprobe

# eslint + eslint-plugin-no-unsanitized, the XSS-sink linter. Installed LOCALLY into a
# prefix dir for the same reason Jazzer.js is, and pinned because the plugin's peer range
# is `eslint: ^9 || ^10`.
#
# The image SHIPS the flat config rather than leaving a campaign to write one. eslint 9
# requires flat config, and the config is an ES module, so it imports the plugin by
# ABSOLUTE PATH: ESM resolution ignores NODE_PATH, and a bare `import ... from
# "no-unsanitized"` fails from any directory that is not the install prefix:
#
#   Error [ERR_MODULE_NOT_FOUND]: Cannot find package 'no-unsanitized' imported from
#   /tmp/p/eslint.config.mjs
#
# `--no-config-lookup` is then a MUST at run time. Without it eslint walks up from the
# target and a config it finds in the target repo silently replaces these two rules, which
# is a scan that reports clean because it checked something else.
# renovate: datasource=npm depName=eslint
ARG ESLINT_VERSION=9.39.5
# renovate: datasource=npm depName=eslint-plugin-no-unsanitized
ARG NO_UNSANITIZED_VERSION=4.1.5
RUN mkdir -p /opt/eslint && cd /opt/eslint \
 && npm init -y >/dev/null \
 && npm i "eslint@${ESLINT_VERSION}" "eslint-plugin-no-unsanitized@${NO_UNSANITIZED_VERSION}" >/dev/null \
 && ln -sf /opt/eslint/node_modules/.bin/eslint /usr/local/bin/eslint \
 && printf 'import noUnsanitized from "/opt/eslint/node_modules/eslint-plugin-no-unsanitized/index.js";\nexport default [{ plugins: { "no-unsanitized": noUnsanitized },\n  rules: { "no-unsanitized/method": "error", "no-unsanitized/property": "error" } }];\n' \
      > /opt/eslint/sabot.config.mjs \
 && eslint --version

# Assert BOTH rules report on seeded sinks, not that eslint answered --version. A plugin
# that loads while contributing no rules leaves eslint exiting 0 on this file.
RUN set -eux; \
    probe=/tmp/esprobe; mkdir -p "$probe"; cd "$probe"; \
    printf 'function render(u) {\n  document.getElementById("x").innerHTML = u;\n  document.write(u);\n}\n' > bad.js; \
    eslint --no-config-lookup -c /opt/eslint/sabot.config.mjs bad.js > out.txt 2>&1 || true; \
    grep -q 'no-unsanitized/property' out.txt || \
      { echo "sabot node: no-unsanitized/property did not report the innerHTML sink" >&2; \
        cat out.txt >&2; exit 1; }; \
    grep -q 'no-unsanitized/method' out.txt || \
      { echo "sabot node: no-unsanitized/method did not report document.write" >&2; \
        cat out.txt >&2; exit 1; }; \
    echo "eslint-plugin-no-unsanitized reports both seeded sinks"; \
    cd /; rm -rf "${probe:?}"

# fast-check is a LIBRARY with no CLI, so it is reachable only via NODE_PATH; a
# harness that does `require("fast-check")` fails without this. Set for every run
# rather than in each recipe.
ENV NODE_PATH=/usr/local/lib/node_modules

# Playwright + chromium, BAKED. `playwright install` downloads a ~150 MiB browser, so
# under --network none it fails and every DAST probe needing a real browser is lost:
# one campaign executed 6 of its 13 probes for exactly this reason and the web surface
# could not be called covered. Only the DOWNLOAD wants egress -- the probes drive
# 127.0.0.1 and run entirely offline once the binary is on disk, which is why this
# belongs in the image rather than in the network stage.
#
# PLAYWRIGHT_BROWSERS_PATH moves the browser out of root's HOME: the default
# /root/.cache/ms-playwright is unreadable to the uid-1000 user every run uses, so the
# browser would be present and unlaunchable -- the same shape as the Jazzer.js bug above.
#
# The launch probe passes --no-sandbox because chromium's own sandbox needs privileges
# run-contained.sh drops. Harnesses MUST pass it too; without it launch() fails at
# runtime while the build reported the browser working.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN npm i -g playwright >/dev/null \
 && apt-get update -q \
 && NODE_PATH=/usr/local/lib/node_modules npx --yes playwright install --with-deps chromium >/dev/null \
 && rm -rf /var/lib/apt/lists/* \
 && chmod -R a+rX /opt/ms-playwright \
 && NODE_PATH=/usr/local/lib/node_modules node -e 'const{chromium}=require("playwright");chromium.launch({args:["--no-sandbox"]}).then(async b=>{console.log("chromium",await b.version());await b.close()})'

# retire.js vulnerability definitions, baked. Pinned by commit SHA of the RetireJS
# repo (tag-less rolling data), advanced by hand; renovate's semver datasource cannot
# track a bare SHA. Fetch only the pinned commit, keep the JSON, drop the rest.
ARG RETIREJS_SHA=680dfa2e2a436c9b66ab758693629a3cb92196ac
RUN mkdir -p /tmp/retirejs && cd /tmp/retirejs && git init -q \
 && git remote add origin https://github.com/RetireJS/retire.js \
 && git fetch -q --depth 1 origin "$RETIREJS_SHA" \
 && git checkout -q FETCH_HEAD \
 && mkdir -p /opt/sabot-db/retire \
 && cp repository/jsrepository-v5.json /opt/sabot-db/retire/ \
 && rm -rf /tmp/retirejs

# The base's `breaker` user is uid 1000, which run-contained.sh runs as. It already owns
# /artifacts, /scratch and the base's /opt/sabot-db; the retire bake above ran as root.
RUN chown -R breaker:breaker /opt/sabot-db/retire
USER breaker
WORKDIR /scratch
VOLUME /artifacts
